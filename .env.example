# Variabili d'ambiente usate dal sito. Solo i nomi: i valori veri stanno in Vercel
# (Project Settings → Environment Variables) e, per lo sviluppo, in .env.local.
# "P+P" = da impostare in Preview e Production.

# --- Database (Neon) ---
# Connessione Postgres usata da tutte le rotte e dagli script. P+P (in Preview un branch Neon di sviluppo).
POSTGRES_URL=
# Solo sviluppo locale: 1 = usa il database Docker di dev/ (vedi dev/README.md). Mai su Vercel.
LOCAL_DB=

# --- Sito ---
# URL pubblico del sito, usato nei link di email e pagamenti. Production: https://www.prolocogasperina.it ; Preview: URL dell'anteprima.
NEXT_PUBLIC_BASE_URL=

# --- Accesso admin e cassa (prompt 02) ---
# Segreto per firmare i cookie di sessione: stringa casuale lunga (es. `openssl rand -base64 32`). P+P, diverso per ambiente.
AUTH_SECRET=
# Hash della password admin, generato con `npm run hash-password -- "nuova password"`. P+P.
ADMIN_PASSWORD_HASH=

# --- Pagamenti (Nexi XPay) ---
# Indirizzo del gateway: int-ecommerce.nexi.it per i test, ecommerce.nexi.it in produzione. P+P (Preview = test).
NEXI_ENDPOINT=
# Alias del terminale Nexi. P+P (Preview = alias di test).
NEXI_ALIAS=
# Chiave segreta per il MAC dei pagamenti. P+P (Preview = chiave di test).
NEXI_MAC_KEY=
# Solo in locale: "simulatore" mostra una finta pagina di Nexi (docs/checkout.md). Mai su Vercel.
NEXI_MODE=
# 1 = i pulsanti d'acquisto di oggi portano al checkout nuovo /acquista/[edizione]. Spento finché Zuccaland vende.
NUOVO_CHECKOUT=

# --- Email (Resend) ---
# Chiave API per l'invio delle email (biglietti, rimborsi, inviti). Production; in Preview meglio vuota o di test.
RESEND_API_KEY=

# --- Immagini (Cloudinary) ---
# Nome del cloud, letto dal server. P+P.
CLOUDINARY_CLOUD_NAME=
# Stesso nome, letto dal browser per i caricamenti. P+P.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Credenziali API per caricare e cancellare foto. P+P.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Notifiche Telegram ---
# Token del bot e chat che riceve le notifiche admin. Solo Production (in Preview vuoto, altrimenti i test arrivano alla chat vera).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Segreto che Telegram rimanda in ogni chiamata al webhook. Solo Production; dopo averlo impostato
# aprire una volta /api/telegram/setup da admin per registrarlo.
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API) ---
# Token e numero per l'invio dei messaggi; nome del modello approvato; token di verifica del webhook. Solo Production.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_VERIFY_TOKEN=
# App Secret dell'app Meta: serve a verificare la firma delle notifiche del webhook. Solo Production.
WHATSAPP_APP_SECRET=

# --- Nucleo ordini (prompt 09) ---
# Chiave AES-256 per cifrare gli IBAN dei rimborsi: 32 byte in base64 (`openssl rand -base64 32`).
# P+P, diversa per ambiente. Se si perde, gli IBAN già salvati non si leggono più.
REFUND_ENCRYPTION_KEY=
# Segreto che Vercel Cron manda come "Authorization: Bearer …" a /api/cron/expire-orders. P+P.
CRON_SECRET=
